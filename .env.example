# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://cryptmaster:cryptmaster@localhost:5432/cryptmaster
# For development without PostgreSQL:
# USE_SQLITE=True

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
AGENT_LOG_LEVEL=DEBUG

# Pionex API (REQUIRED for live trading)
PIONEX_API_KEY=
PIONEX_API_SECRET=

# Trading Mode
# Set to False for live trading (CAUTION!)
DRY_RUN=True

# Risk Management
RISK_MAX_POSITION_PCT=0.10
RISK_MAX_PER_TRADE=0.02
RISK_MAX_DRAWDOWN=0.20
RISK_MIN_CONFIDENCE=0.85
RISK_BOT_LOSS_THRESHOLD=0.10

# Analysis Configuration
ANALYSIS_INTERVAL_SECONDS=60
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BOLLINGER_PERIOD=20
BOLLINGER_STD=2.0

# LLM News Analysis (Ollama)
# Enabled by default in Docker deployment
LLM_ENABLED=True
OLLAMA_MODEL=llama3.2
# Memory limit for Ollama container (default 4G, adjust based on EC2 instance)
OLLAMA_MEMORY_LIMIT=4G

# Market Intelligence Layer - External Data Sources
# Market data provider: "coingecko" (free tier) or "coinmarketcap" (requires API key)
MARKET_DATA_PROVIDER=coingecko
# API key for CoinMarketCap (optional for CoinGecko)
MARKET_DATA_API_KEY=
# Custom base URL (optional, defaults to provider's public endpoint)
MARKET_DATA_BASE_URL=
# Request timeout in seconds
MARKET_DATA_TIMEOUT=30.0
# Maximum retry attempts on failure
MARKET_DATA_MAX_RETRIES=3
