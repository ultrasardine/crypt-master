# =============================================================================
# Docker Compose Environment Variables
# =============================================================================
# Copy this file to .env.docker and fill in the values
# Usage: docker compose --env-file .env.docker up -d
# =============================================================================

# -----------------------------------------------------------------------------
# Image Configuration
# -----------------------------------------------------------------------------
# Docker image tag to use (default: latest)
IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Django Settings
# -----------------------------------------------------------------------------
# REQUIRED: Generate a secure secret key for production
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_DB=cryptmaster
POSTGRES_USER=cryptmaster
# REQUIRED: Set a strong password for production
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Redis is configured internally via docker-compose.yml
# No additional configuration needed

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
AGENT_LOG_LEVEL=DEBUG

# -----------------------------------------------------------------------------
# Pionex API Credentials
# -----------------------------------------------------------------------------
# REQUIRED: Your Pionex API credentials
# Get these from: https://www.pionex.com/en/api
PIONEX_API_KEY=
PIONEX_API_SECRET=

# -----------------------------------------------------------------------------
# Trading Mode
# -----------------------------------------------------------------------------
# IMPORTANT: Set to True for simulation mode (no real trades)
# Set to False ONLY when ready for live trading
DRY_RUN=True

# -----------------------------------------------------------------------------
# Risk Management
# -----------------------------------------------------------------------------
# Maximum position size as percentage of portfolio (default: 10%)
RISK_MAX_POSITION_PCT=0.10

# Maximum risk per trade as percentage of portfolio (default: 2%)
RISK_MAX_PER_TRADE=0.02

# Maximum drawdown before halting trading (default: 20%)
RISK_MAX_DRAWDOWN=0.20

# Minimum confidence score to execute trades (default: 85%)
RISK_MIN_CONFIDENCE=0.85

# Bot loss threshold for auto-stop (default: 10%)
RISK_BOT_LOSS_THRESHOLD=0.10

# -----------------------------------------------------------------------------
# Analysis Configuration
# -----------------------------------------------------------------------------
# Interval between market analysis cycles (seconds)
ANALYSIS_INTERVAL_SECONDS=60

# RSI period (default: 14)
RSI_PERIOD=14

# MACD parameters
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Bollinger Bands parameters
BOLLINGER_PERIOD=20
BOLLINGER_STD=2.0

# -----------------------------------------------------------------------------
# LLM News Analysis (Ollama)
# -----------------------------------------------------------------------------
# Ollama runs as a Docker service for news sentiment analysis
# Enabled by default - the model is pulled automatically on first startup

# Enable/disable LLM-based news sentiment analysis
LLM_ENABLED=True

# Ollama model to use (pulled automatically by ollama-init service)
OLLAMA_MODEL=llama3.2

# Memory limit for Ollama container
# Adjust based on EC2 instance size:
# - t4g.medium (4GB): 3G
# - t4g.large (8GB): 6G
# - t4g.xlarge (16GB): 12G
OLLAMA_MEMORY_LIMIT=4G
